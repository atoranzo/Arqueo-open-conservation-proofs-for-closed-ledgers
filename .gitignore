/target
**/*.rs.bk
Cargo.lock
# Ledgers de prueba
/ledger*
*.bin

# Secretos: nunca deben llegar al repositorio
.env
*.key
*.pem
secrets
.DS_Store

# Scripts de parche de un solo uso (se aplican desde la raiz y se borran).
# NO afecta a los .py del proyecto, que viven en subdirectorios.
/*.py
# marcas NTFS que WSL materializa al arrastrar desde Windows
*:Zone.Identifier

# Verificadores de sello y bancos sueltos: la convencion es borrarlos tras
# usarlos (arriba), pero 23 sobrevivieron hasta §217 y ahogaron un cerrojo
# que intentaba enseñar la unica linea que importaba. Red, no sustituto.
/BLOQUE-*.sh
/BANCO-*.sh
# Bytecode de Python: lo generan las herramientas de doc/fv y tools/.
__pycache__/
*.pyc

# Registro de cuando paso el canon --completo por ultima vez. NO se
# versiona a proposito: es un hecho de ESTA maquina, y en un clon nuevo
# la respuesta correcta es "nunca".
/.canon/
